// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model Waitlist {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model User {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  UserRole               @default(USER)
  accounts              Account[]
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?

  tokens                Int                    @default(100)
  generatedImages       Int                    @default(0)
  submissions          Submission[]           @relation("UserSubmissions")
  productImages        ProductImage[]         @relation("UserProductImages")
  generations          Generation[]           @relation("UserGenerations")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @map("user_id") @db.ObjectId
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId])
}

model Submission {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation("UserSubmissions", fields: [userId], references: [id])
  generationId      String?  @db.ObjectId
  generation        Generation? @relation("SubmissionGeneration", fields: [generationId], references: [id])
  createdAt         DateTime @default(now())
  productName       String
  productTagline    String
  productCategory   String
  highlightedBenefit String
  productDescription String
  brandName         String
  brandTone         String
  colorTheme        String
  backgroundStyle   String
  lightingStyle     String
  productPlacement  String
  typographyStyle   String
  compositionGuidelines String
  
  // Original uploaded image
  originalImageUrl     String
  originalImagePublicId String
  
  // Generated creative images
  instagramPostImageUrl   String
  instagramPostImagePublicId String
  instagramStoryImageUrl  String
  instagramStoryImagePublicId String
  facebookPostImageUrl    String
  facebookPostImagePublicId String
  linkedinPostImageUrl    String
  linkedinPostImagePublicId String
  websiteBannerImageUrl   String
  websiteBannerImagePublicId String
}

enum ProductImageType {
  Original
  Variation
  Upscaled
}

enum GenerationType {
  AD_CREATIVE
  PRODUCT_SHOT
}

enum GenerationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Generation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user User @relation("UserGenerations", fields: [userId], references: [id])

  type GenerationType
  status GenerationStatus @default(PENDING)
  
  // Generation parameters
  prompt String?
  aspectRatio String?
  scene String?
  numberOfImages Int @default(1)
  
  // Product details (for ad creatives)
  productName String?
  productCategory String?
  productTagline String?
  productDescription String?
  brandName String?
  brandTone String?
  colorTheme String?
  backgroundStyle String?
  lightingStyle String?
  productPlacement String?
  typographyStyle String?
  compositionGuidelines String?
  highlightedBenefit String?
  
  // Original uploaded image
  originalImageUrl String?
  originalImagePublicId String?
  
  // Related data
  submissions Submission[] @relation("SubmissionGeneration")
  productImages ProductImage[] @relation("GenerationProductImages")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("generations")
}

model ProductImage {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user User @relation("UserProductImages", fields: [userId], references: [id])

  generationId String @db.ObjectId
  generation Generation @relation("GenerationProductImages", fields: [generationId], references: [id])

  prompt String
  aspectRatio String
  scene String

  imageUrl String
  imagePublicId String
  type ProductImageType
  originalImageUrl String?
  originalImagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}
