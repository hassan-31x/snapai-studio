# Node 24 LTS. Use your final HTTPS origin in production.
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Optional search engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# MongoDB Atlas or another replica set. Transactions require a replica set.
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/snapai_studio?retryWrites=true&w=majority"
# Generate: openssl rand -hex 32
AUTH_SECRET=""

# Required for live generation. Keep all provider keys server side.
OPENROUTER_API_KEY=""
OPENROUTER_TEXT_MODEL="google/gemini-2.5-flash-lite"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-lite-image"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required for registration verification, resets, and email two factor authentication.
RESEND_API_KEY=""
FROM_EMAIL="SnapAI Studio <hello@your-verified-domain.com>"

# Optional. Leave both blank to disable Google sign in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional scheduled maintenance endpoint. Generate: openssl rand -hex 32
CRON_SECRET=""
# For multiple self-hosted instances, share a stable action encryption key.
# Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
